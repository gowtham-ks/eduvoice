# Environment
ENVIRONMENT=development  # Set to 'production' for production deployment

# Database
DATABASE_URL=sqlite:///./eduvoice.db  # Use PostgreSQL in production

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-in-production-use-64-random-characters-minimum
COOKIE_SECURE=false  # Set to true in production (requires HTTPS)

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# Signing Key (for blind signatures)
# Generate with: python -m app.bootstrap genkey
SIGNING_KEY_PEM_B64=
SIGNING_KEY_PATH=./signing_key.pem

# Privacy Thresholds
MIN_RESPONSES=5  # Minimum responses before showing any stats
MIN_COMMENTS_VISIBLE=10  # Minimum responses before showing comments

# Optional: Advanced ML (requires transformers + torch)
USE_HF_MODELS=false
