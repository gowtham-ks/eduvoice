# ---- Local development ----
ENVIRONMENT=development
DATABASE_URL=sqlite:///./eduvoice.db
JWT_SECRET=dev-only-secret
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# ---- Production (set these in your host's dashboard, never commit them) ----
# ENVIRONMENT=production
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# JWT_SECRET=<64+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))">
# SIGNING_KEY_PEM_B64=<output of:  python -m app.bootstrap genkey>
# FRONTEND_ORIGIN=https://your-app.vercel.app
# COOKIE_SECURE=true

MIN_RESPONSES=5
MIN_COMMENTS_VISIBLE=10
USE_HF_MODELS=false

# ---- Mail (self-signup verification + admin-invite emails) ----
# Leave SMTP_HOST empty locally: emails are logged instead of sent.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your@gmail.com,
# SMTP_PASSWORD=<a 16-character App Password from myaccount.google.com/apppasswords>
# (App Passwords need 2-Step Verification turned on for that Google account.)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EduVoice <your@gmail.com>
ADMIN_NOTIFY_EMAIL=
# Comma-separated; leave empty to allow self-signup from any email domain
ALLOWED_EMAIL_DOMAINS=
